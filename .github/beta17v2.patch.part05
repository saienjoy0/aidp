-assert(content.includes("0.7.9-beta.16"), 'content version');
-assert(worker.includes("0.7.9-beta.16"), 'worker version');
-assert(offscreen.includes('0.7.9-beta.16'), 'offscreen version');
-assert(panel.includes('Integrated Beta 16'), 'panel version');
-assert(!panel.includes('structural-approval'), 'approval UI removed');
-assert(!panelJs.includes('runApproveStructural'), 'approval handler removed');
-assert(worker.includes('structuralOperationIdsFromPatch'), 'auto structural approval present');
