{
  "manifest_version": 3,
  "name": "AIDP ↔ ChatGPT Bridge v0.7.9 Beta 42 QC One-Click R2",
  "version": "0.7.9.422",
  "description": "One-click AIDP ZIP export with active-tab following, tab/case-isolated state, per-tab export jobs, QC/rework history capture, BGM speaker support, and global mutation lock. Submit/staging are never automated.",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "downloads",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://aidp.bytedance.com/*",
    "https://*.bytetos.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aidp.bytedance.com/management/task-v2/*"],
      "js": ["rework_probe_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://aidp.bytedance.com/management/task-v2/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {"default_path":"sidepanel.html"},
  "action":{"default_title":"AIDP ↔ ChatGPT Bridge"},
  "minimum_chrome_version":"114"
}
